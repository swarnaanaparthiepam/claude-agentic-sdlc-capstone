{
  "$schema": "https://claude.ai/schemas/settings-v1.json",
  "description": "Project-level Claude Code settings for SDLC workflow",

  "permissions": {
    "allow": [
      "Read",
      "Bash:git status",
      "Bash:git branch",
      "Bash:git log",
      "Bash:npm run",
      "Bash:node"
    ],
    "deny": []
  },

  "agents": {
    "timeout": 300000,
    "maxConcurrent": 3
  },

  "workflow": {
    "requireApproval": true,
    "autoAdvance": false,
    "artifactPath": "docs/artifacts"
  },

  "integrations": {
    "jira": {
      "enabled": true,
      "mcpServer": "atlassian"
    },
    "github": {
      "enabled": true,
      "defaultReviewers": []
    }
  },

  "security": {
    "secretsScanning": true,
    "tokenMasking": "!@#$$$#@",
    "forbiddenFiles": [
      "mcp.json",
      ".claude/mcp.json",
      ".env",
      ".env.local"
    ]
  },

  "codeQuality": {
    "linting": true,
    "formatting": true,
    "testCoverage": 80
  }
}